# ── STEPWISE server ────────────────────────────────────────────────
# Copy to server/.env and adjust.

PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed to call the API from a browser.
# In development the localhost defaults are also allowed automatically.
# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=

# Database ------------------------------------------------------------------
# Leave DATABASE_PROVIDER empty (or "sqlite") to use SQLite (zero configuration, local file).
# Set DATABASE_PROVIDER=supabase and the two values below for cross-device sync.
DATABASE_PROVIDER=sqlite
# DATABASE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local SQLite location (relative to repo root)
# SQLITE_PATH=server/data/stepwise.db

# Optional: generate the question bank from text files into a custom location
# STEP_SOURCE_DIR=html/models_5_to_51_text
# STEP_BANK_FILE=server/data/step-bank.json

# Serve the built React app from Express (used for single-service deployment)
SERVE_STATIC=true
TRUST_PROXY=true
